# Supabase Configuration (Required for cloud persistence on Netlify)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Admin & Editorial Controls
# Set to "true" to show "Write Dispatch" and "Supabase Sync" in production builds.
# By default in production builds, the blog runs in read-only mode unless VITE_ENABLE_ADMIN=true or ?admin=1 is used.
VITE_ENABLE_ADMIN=false
